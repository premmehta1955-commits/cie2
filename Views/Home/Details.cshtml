@model HospitalAppointmentSystem.Models.Doctor

@{
    ViewData["Title"] = "Doctor Details";
}

<style>
    .details-container {
        max-width: 800px;
        margin: 40px auto;
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .details-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 40px;
        text-align: center;
    }

    .doctor-avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        margin: 0 auto 20px;
    }

    .doctor-name {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .doctor-specialty {
        background: rgba(255, 255, 255, 0.2);
        display: inline-block;
        padding: 8px 20px;
        border-radius: 25px;
        font-size: 1rem;
        font-weight: 600;
    }

    .details-body {
        padding: 40px;
    }

    .info-section {
        margin-bottom: 30px;
    }

    .info-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 15px 0;
        border-bottom: 1px solid #e9ecef;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-label {
        color: #666;
        font-weight: 600;
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .info-value {
        color: #333;
        font-weight: 700;
        font-size: 1.1rem;
    }

    .experience-badge {
        background: #4ade80;
        color: white;
        padding: 6px 15px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .fee-badge {
        background: #fbbf24;
        color: white;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1.05rem;
    }

    .total-charge {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 20px;
        border-radius: 10px;
        text-align: center;
        margin: 30px 0;
    }

    .total-label {
        font-size: 0.9rem;
        opacity: 0.9;
        margin-bottom: 5px;
    }

    .total-amount {
        font-size: 2.5rem;
        font-weight: 700;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn {
        flex: 1;
        padding: 15px 25px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(102, 126, 234, 0.4);
        color: white;
        text-decoration: none;
    }

    .btn-secondary {
        background: #f0f0f0;
        color: #667eea;
        border: 2px solid #667eea;
    }

    .btn-secondary:hover {
        background: #667eea;
        color: white;
        text-decoration: none;
    }

    .description-text {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid #667eea;
        color: #666;
        line-height: 1.6;
        margin: 20px 0;
    }

    @@media (max-width: 600px) {
        .action-buttons {
            flex-direction: column;
        }

        .details-body {
            padding: 20px;
        }

        .doctor-name {
            font-size: 1.5rem;
        }

        .total-amount {
            font-size: 2rem;
        }
    }


<div class="details-container">
    <div class="details-header">
        <div class="doctor-avatar">👨‍⚕️</div>
        <h1 class="doctor-name">@Model.DoctorName</h1>
        <span class="doctor-specialty">@Model.Specialization Specialist</span>
    </div>

    <div class="details-body">
        <div class="description-text">
            <strong>Professional Information</strong><br>
            Learn more about @Model.DoctorName's qualifications, experience, and consultation details below.
        </div>

        <div class="info-section">
            <div class="info-row">
                <span class="info-label">🏥 Doctor ID</span>
                <span class="info-value">#@Model.DoctorId</span>
            </div>

            <div class="info-row">
                <span class="info-label">👤 Full Name</span>
                <span class="info-value">@Model.DoctorName</span>
            </div>

            <div class="info-row">
                <span class="info-label">🎓 Medical Specialty</span>
                <span class="info-value">@Model.Specialization</span>
            </div>

            <div class="info-row">
                <span class="info-label">📚 Years of Experience</span>
                <span class="experience-badge">@Model.Experience+ Years</span>
            </div>

            <div class="info-row">
                <span class="info-label">💰 Consultation Fee</span>
                <span class="fee-badge">₹@Model.ConsultationFee</span>
            </div>

            <div class="info-row">
                <span class="info-label">🏪 Service Charge</span>
                <span class="fee-badge">₹100</span>
            </div>
        </div>

        <div class="total-charge">
            <div class="total-label">Total Cost for Appointment</div>
            <div class="total-amount">₹@Model.CalculateTotalCharge()</div>
        </div>

        <div class="action-buttons">
            <a href="/Home/Appointment?doctorId=@Model.DoctorId" class="btn btn-primary">
                <span>📅</span>
                <span>Schedule Appointment</span>
            </a>
            <a href="/Home/Index" class="btn btn-secondary">
                <span>←</span>
                <span>Back to Doctors</span>
            </a>
        </div>
    </div>
</div>
