@model HospitalAppointmentSystem.Models.Doctor

@{
    ViewData["Title"] = "Appointment Confirmation";
}

<style>
    .confirmation-container {
        max-width: 700px;
        margin: 40px auto;
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .confirmation-header {
        background: linear-gradient(135deg, #4ade80 0%, #22c55e 100%);
        color: white;
        padding: 50px 40px;
        text-align: center;
    }

    .success-icon {
        font-size: 4rem;
        margin-bottom: 20px;
        animation: scaleUp 0.5s ease-out;
    }

    .confirmation-title {
        font-size: 2rem;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .confirmation-subtitle {
        font-size: 1.1rem;
        opacity: 0.9;
    }

    .confirmation-body {
        padding: 40px;
    }

    .greeting-text {
        background: #f0fdf4;
        border-left: 4px solid #4ade80;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
        color: #16a34a;
        font-size: 1.05rem;
    }

    .confirmation-details {
        background: #f8f9fa;
        padding: 25px;
        border-radius: 10px;
        margin-bottom: 30px;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #e9ecef;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #666;
        font-weight: 600;
        font-size: 0.95rem;
    }

    .detail-value {
        color: #333;
        font-weight: 700;
        font-size: 1rem;
    }

    .appointment-summary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 25px;
        border-radius: 10px;
        text-align: center;
        margin: 30px 0;
    }

    .summary-label {
        font-size: 0.9rem;
        opacity: 0.9;
        margin-bottom: 10px;
    }

    .summary-amount {
        font-size: 2.5rem;
        font-weight: 700;
    }

    .info-sections {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 30px;
    }

    .info-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        border-left: 4px solid #667eea;
    }

    .info-card-title {
        font-weight: 700;
        color: #333;
        margin-bottom: 10px;
        font-size: 0.95rem;
    }

    .info-card-content {
        color: #666;
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .action-buttons {
        display: flex;
        gap: 15px;
        margin-top: 30px;
    }

    .btn {
        flex: 1;
        padding: 15px 25px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
        text-decoration: none;
    }

    .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 25px rgba(102, 126, 234, 0.4);
        color: white;
        text-decoration: none;
    }

    .next-steps {
        background: #fef3c7;
        border-left: 4px solid #f59e0b;
        padding: 20px;
        border-radius: 8px;
        color: #92400e;
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .next-steps strong {
        display: block;
        margin-bottom: 10px;
    }

    @@keyframes scaleUp {
        from {
            transform: scale(0.8);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }
</style>

<style>
    @@media (max-width: 600px) {
        .confirmation-body {
            padding: 20px;
        }

        .info-sections {
            grid-template-columns: 1fr;
        }

        .action-buttons {
            flex-direction: column;
        }

        .confirmation-title {
            font-size: 1.5rem;
        }

        .summary-amount {
            font-size: 2rem;
        }
    }
</style>

<div class="confirmation-container">
    <div class="confirmation-header">
        <div class="success-icon">✓</div>
        <h1 class="confirmation-title">Appointment Confirmed</h1>
        <p class="confirmation-subtitle">Your booking request has been successfully received</p>
    </div>

    <div class="confirmation-body">
        <!-- Welcome Message -->
        <div class="greeting-text">
            <strong>Thank you, @ViewBag.PatientName!</strong><br>
            We have successfully received your appointment request. Our team will contact you shortly to confirm the final details.
        </div>

        <!-- Appointment Details -->
        <div class="confirmation-details">
            <div class="detail-row">
                <span class="detail-label">👨‍⚕️ Doctor</span>
                <span class="detail-value">@Model.DoctorName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">🎓 Specialty</span>
                <span class="detail-value">@Model.Specialization</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">💰 Consultation Fee</span>
                <span class="detail-value">₹@Model.ConsultationFee</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">🏪 Service Charge</span>
                <span class="detail-value">₹100</span>
            </div>
        </div>

        <!-- Total Charge -->
        <div class="appointment-summary">
            <div class="summary-label">Total Amount to Pay</div>
            <div class="summary-amount">₹@Model.CalculateTotalCharge()</div>
        </div>

        <!-- Info Cards -->
        <div class="info-sections">
            <div class="info-card">
                <div class="info-card-title">📋 What's Next?</div>
                <div class="info-card-content">
                    Our office will call you within 24 hours to confirm your preferred appointment time.
                </div>
            </div>
            <div class="info-card">
                <div class="info-card-title">📞 Need Help?</div>
                <div class="info-card-content">
                    Contact us at support@hospital.com or call 1800-XXX-XXXX for any questions.
                </div>
            </div>
        </div>

        <!-- Important Notes -->
        <div class="next-steps">
            <strong>📌 Important Notes:</strong>
            • Please arrive 15 minutes before your scheduled appointment time<br>
            • Bring a valid photo ID and health insurance card if applicable<br>
            • You will receive a confirmation SMS and email shortly
        </div>

        <!-- Action Buttons -->
        <div class="action-buttons">
            <a href="/Home/Index" class="btn btn-primary">
                ← Return to Home
            </a>
        </div>
    </div>
</div>
