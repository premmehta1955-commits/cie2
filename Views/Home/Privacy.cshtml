@{
    ViewData["Title"] = "Privacy Policy";
}

<style>
    .privacy-container {
        max-width: 900px;
        margin: 40px auto;
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    }

    .privacy-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 50px 40px;
        text-align: center;
    }

    .privacy-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .privacy-subtitle {
        font-size: 1rem;
        opacity: 0.9;
    }

    .privacy-body {
        padding: 40px;
        line-height: 1.8;
        color: #333;
    }

    .privacy-section {
        margin-bottom: 35px;
    }

    .section-title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #667eea;
        margin-bottom: 15px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e9ecef;
    }

    .section-content {
        font-size: 1rem;
        line-height: 1.8;
        color: #666;
    }

    .section-content p {
        margin-bottom: 15px;
    }

    .section-content ul {
        margin-left: 25px;
        margin-bottom: 15px;
    }

    .section-content li {
        margin-bottom: 10px;
        line-height: 1.6;
    }

    .highlight-box {
        background: #f0f7ff;
        border-left: 4px solid #667eea;
        padding: 20px;
        border-radius: 8px;
        margin: 20px 0;
    }

    .highlight-box strong {
        color: #667eea;
    }

    .contact-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 30px;
        border-radius: 10px;
        margin-top: 40px;
        text-align: center;
    }

    .contact-section h3 {
        margin-bottom: 15px;
    }

    .contact-email {
        font-size: 1.1rem;
        font-weight: 600;
    }

    .last-updated {
        text-align: center;
        padding-top: 30px;
        border-top: 2px solid #e9ecef;
        color: #999;
        font-size: 0.9rem;
        margin-top: 40px;
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
        margin-top: 20px;
    }

    .back-btn:hover {
        transform: translateX(-5px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
        color: white;
        text-decoration: none;
    }

    @@media (max-width: 768px) {
        .privacy-header {
            padding: 30px 20px;
        }

        .privacy-title {
            font-size: 1.8rem;
        }

        .privacy-body {
            padding: 20px;
        }

        .section-title {
            font-size: 1.2rem;
        }
    }
</style>

<div class="privacy-container">
    <div class="privacy-header">
        <h1 class="privacy-title">🔒 Privacy Policy</h1>
        <p class="privacy-subtitle">Your privacy is our priority</p>
    </div>

    <div class="privacy-body">
        <!-- Introduction -->
        <div class="privacy-section">
            <h2 class="section-title">📋 Introduction</h2>
            <div class="section-content">
                <p>
                    Welcome to the Hospital Appointment System ("we," "us," "our," or "Company"). At our hospital, we are committed to protecting your privacy and ensuring you have a positive experience on our website and when using our services.
                </p>
                <p>
                    This Privacy Policy explains how we collect, use, disclose, and safeguard your information when you visit our website and use our appointment booking services.
                </p>
                <p>
                    <strong>Please read this privacy policy carefully.</strong> If you do not agree with our policies and practices, please do not use our website.
                </p>
            </div>
        </div>

        <!-- Information We Collect -->
        <div class="privacy-section">
            <h2 class="section-title">📊 Information We Collect</h2>
            <div class="section-content">
                <p>We may collect information about you in a variety of ways:</p>
                <ul>
                    <li><strong>Personal Information:</strong> Name, email address, phone number, date of birth, and medical history when you create an appointment</li>
                    <li><strong>Healthcare Information:</strong> Medical conditions, medications, allergies, and previous treatments</li>
                    <li><strong>Device Information:</strong> Browser type, IP address, operating system, and browsing activities through cookies</li>
                    <li><strong>Usage Data:</strong> Pages visited, time spent on pages, links clicked, and referrer URLs</li>
                    <li><strong>Payment Information:</strong> Credit card details (processed securely through third-party payment providers)</li>
                </ul>

                <div class="highlight-box">
                    <strong>⚠️ Note:</strong> We do not store credit card information directly on our servers. Payment processing is handled by secure third-party payment gateways.
                </div>
            </div>
        </div>

        <!-- How We Use Your Information -->
        <div class="privacy-section">
            <h2 class="section-title">💡 How We Use Your Information</h2>
            <div class="section-content">
                <p>We use the information we collect for the following purposes:</p>
                <ul>
                    <li>To create and manage your account and appointments</li>
                    <li>To provide you with healthcare services and send appointment confirmations</li>
                    <li>To send you reminders and updates regarding your appointments</li>
                    <li>To improve our website functionality and user experience</li>
                    <li>To comply with legal obligations and healthcare regulations</li>
                    <li>To communicate with you about our services and respond to inquiries</li>
                    <li>To prevent fraud and enhance security measures</li>
                    <li>To conduct medical research (with your explicit consent)</li>
                </ul>
            </div>
        </div>

        <!-- Data Protection & Security -->
        <div class="privacy-section">
            <h2 class="section-title">🔐 Data Protection & Security</h2>
            <div class="section-content">
                <p>
                    Your healthcare information is sensitive and protected under applicable data protection regulations. We implement robust security measures including:
                </p>
                <ul>
                    <li>SSL encryption for data transmission</li>
                    <li>Secure password storage using hashing algorithms</li>
                    <li>Regular security audits and vulnerability assessments</li>
                    <li>Restricted access to personal information (need-to-know basis)</li>
                    <li>Firewalls and intrusion detection systems</li>
                    <li>Regular data backups and disaster recovery procedures</li>
                </ul>
                <p>
                    However, no method of transmission over the Internet or electronic storage is 100% secure. While we strive to protect your personal information, we cannot guarantee absolute security.
                </p>
            </div>
        </div>

        <!-- Your Rights & Choices -->
        <div class="privacy-section">
            <h2 class="section-title">✋ Your Rights & Choices</h2>
            <div class="section-content">
                <p>Depending on your location, you may have the following rights:</p>
                <ul>
                    <li><strong>Right to Access:</strong> Request access to your personal data</li>
                    <li><strong>Right to Correction:</strong> Request correction of inaccurate information</li>
                    <li><strong>Right to Deletion:</strong> Request deletion of your data (subject to legal obligations)</li>
                    <li><strong>Right to Data Portability:</strong> Request a copy of your data in a portable format</li>
                    <li><strong>Right to Opt-Out:</strong> Opt out of marketing communications</li>
                    <li><strong>Right to Withdraw Consent:</strong> Withdraw consent for data processing</li>
                </ul>
                <p>
                    To exercise any of these rights, please contact us using the information provided in the "Contact Us" section below.
                </p>
            </div>
        </div>

        <!-- Cookies & Tracking -->
        <div class="privacy-section">
            <h2 class="section-title">🍪 Cookies & Tracking Technologies</h2>
            <div class="section-content">
                <p>
                    Our website uses cookies and similar tracking technologies to enhance your experience:
                </p>
                <ul>
                    <li><strong>Essential Cookies:</strong> Required for website functionality (login, sessions)</li>
                    <li><strong>Preference Cookies:</strong> Remember your settings and preferences</li>
                    <li><strong>Analytics Cookies:</strong> Help us understand how users interact with our website</li>
                    <li><strong>Third-party Cookies:</strong> Used by partners for advertising and analytics</li>
                </ul>
                <p>
                    You can control cookie settings through your browser preferences. However, disabling cookies may affect website functionality.
                </p>
            </div>
        </div>

        <!-- Third-Party Sharing -->
        <div class="privacy-section">
            <h2 class="section-title">🤝 Sharing Your Information</h2>
            <div class="section-content">
                <p>
                    We do not sell, trade, or rent your personal information to third parties. However, we may share your information in the following circumstances:
                </p>
                <ul>
                    <li><strong>Healthcare Providers:</strong> With doctors and medical professionals involved in your care</li>
                    <li><strong>Service Providers:</strong> With vendors who assist in operating our website (e.g., payment processors, email services)</li>
                    <li><strong>Legal Requirements:</strong> When required by law or to protect our rights</li>
                    <li><strong>Business Transfers:</strong> In case of merger, acquisition, or sale of assets</li>
                    <li><strong>Your Consent:</strong> When you explicitly authorize sharing with third parties</li>
                </ul>

                <div class="highlight-box">
                    <strong>HIPAA Compliance:</strong> Your health information is protected under HIPAA regulations. We only share protected health information with authorized parties for treatment, payment, or healthcare operations.
                </div>
            </div>
        </div>

        <!-- Data Retention -->
        <div class="privacy-section">
            <h2 class="section-title">⏰ Data Retention</h2>
            <div class="section-content">
                <p>
                    We retain your personal information for as long as necessary to provide our services and comply with legal obligations:
                </p>
                <ul>
                    <li><strong>Account Data:</strong> Retained until you request deletion</li>
                    <li><strong>Medical Records:</strong> Retained according to healthcare regulations (typically 6-10 years)</li>
                    <li><strong>Appointment History:</strong> Retained for 7 years for reference and legal purposes</li>
                    <li><strong>Cookies:</strong> Deleted based on cookie settings (typically 1 month to 2 years)</li>
                </ul>
            </div>
        </div>

        <!-- Children's Privacy -->
        <div class="privacy-section">
            <h2 class="section-title">👶 Children's Privacy</h2>
            <div class="section-content">
                <p>
                    Our website is not intended for children under 13 years old. We do not knowingly collect information from children under 13. If we become aware that we have collected information from a child under 13, we will take steps to delete such information promptly.
                </p>
                <p>
                    For users ages 13-18, a parent or guardian's consent may be required for certain services.
                </p>
            </div>
        </div>

        <!-- Updates to Privacy Policy -->
        <div class="privacy-section">
            <h2 class="section-title">📝 Updates to This Privacy Policy</h2>
            <div class="section-content">
                <p>
                    We may update this Privacy Policy periodically to reflect changes in our practices, technology, legal requirements, or other factors. We will notify you of any material changes by posting the updated policy on our website with a revised "Last Updated" date.
                </p>
                <p>
                    Your continued use of our website after any modifications signifies your acceptance of the updated Privacy Policy.
                </p>
            </div>
        </div>

        <!-- Contact Section -->
        <div class="contact-section">
            <h3>📞 Questions or Concerns?</h3>
            <p>If you have any questions about this Privacy Policy or our privacy practices, please contact us:</p>
            <div class="contact-email">
                📧 Email: privacy@hospital.com<br>
                📞 Phone: 1-800-XXX-XXXX<br>
                📍 Address: Hospital Main Building, Medical City
            </div>
        </div>

        <div class="last-updated">
            <p><strong>Last Updated:</strong> October 2026</p>
            <p><strong>Effective Date:</strong> October 1, 2026</p>
        </div>

        <div style="text-align: center;">
            <a href="/Home/Index" class="back-btn">
                <span>←</span>
                <span>Back to Home</span>
            </a>
        </div>
    </div>
</div>

